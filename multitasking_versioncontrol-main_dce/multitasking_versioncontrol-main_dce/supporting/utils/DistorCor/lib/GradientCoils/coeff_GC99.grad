#*[ Script ****************************************************************\
#
#  This file uses Lnorm = 4, i.e. implicitly
#  A(1,0) = 1.0
#  A(1,1) = 1.1547 (2/Sqrt[3])
#  B(1,1) = 1.1547 (2/Sqrt[3])
#
#*************************************************************************
#
# Name        : AS098_3T.grad (Design per 11/11/08)
#
# Author      : R.Kimmlingen
#
# Language    : 
#
# Description : Defines Legendre coefficients in spherical harmonics for
#               Gradient Coil daVinci 3T Espresso (r0=0.25m) 
#               
#****************************************************************************/

#*] END: */
 flagship 098, Gradientsystem daVinci_3T_Espresso , Gx,y,z = 45 mT/m
 win_low = 0, win_high = 0, win_algo = 0, win_dummy = 2;
 0.250 m = R0, lnorm = 4? A(1,0) = B(1,1) = A(1,1) = 0;
 0 = CoSyMode;
 Expansion in   Spherical   Harmonics
 ================================

